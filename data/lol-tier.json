  "patchNotes": {
    "buffs": "安妮（提伯斯全面強化）、阿祈爾（攻距＋W 比例）、巴德（Q 傷害與係數）、伊澤瑞爾（W／R）、加里歐（W 護盾比例大幅上调）、納爾（Q 比例）、K'Sante（W 基礎傷害）、Mel（Q／W）、菲艾（E 傷害）。",
    "nerfs": "勒布朗（Q AP 係數 40%→35%）、易大師（Q AD 係數，針對暴擊流）、星朵拉（E 魔力＋冷卻）、伏打旋風劍（觸發傷害 9%/7%→8%/6%）。",
    "sourceUrl": "https://www.leagueoflegends.com/en-us/news/game-updates/league-of-legends-patch-26-23-notes",
    "sourceLabel": "Riot 官方 Patch 26.23 Notes"
  }
}
